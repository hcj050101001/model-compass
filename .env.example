# Artificial Analysis Data API
AA_API_KEY=
AA_API_TIER=free
AA_API_BASE_URL=https://artificialanalysis.ai/api/v2

# OpenRouter optional enrichment
OPENROUTER_ENABLED=true
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Sync & Database
DATA_SYNC_INTERVAL_MINUTES=60
MANUAL_SYNC_COOLDOWN_SECONDS=120
DATABASE_URL=file:./data/frontier.db

# Application
APP_NAME=LLM Frontier
APP_TIMEZONE=Asia/Shanghai
DEMO_MODE=true
# Production requires an explicit true (viewer login) or false (public reads).
PRIVATE_MODE=true

# ACCESS_PASSWORD and SESSION_SECRET are required in production and for private development.
# Generate each credential independently using a cryptographically secure random generator.
# Viewer login password. Generate at least 24 random characters with a password manager.
ACCESS_PASSWORD=
# HMAC session signing key (at least 32 characters). Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional server-only manual sync token (at least 32 characters). Generate with: openssl rand -hex 32
# Supply as x-admin-token from the operator environment. Leave empty to disable manual HTTP sync.
ADMIN_TOKEN=
