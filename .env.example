# Artificial Analysis Data API
AA_API_KEY=
AA_API_TIER=free
AA_API_BASE_URL=https://artificialanalysis.ai/api/v2

# OpenRouter optional enrichment
OPENROUTER_ENABLED=true
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Sync & Database
DATA_SYNC_INTERVAL_MINUTES=60
MANUAL_SYNC_COOLDOWN_SECONDS=120
DATABASE_URL=file:./data/frontier.db

# Application
APP_NAME=LLM Frontier
APP_TIMEZONE=Asia/Shanghai
DEMO_MODE=true
# Production requires an explicit true (viewer login) or false (public reads).
PRIVATE_MODE=true
# Set TRUST_PROXY=true behind a trusted reverse proxy that overwrites or appends
# the peer IP to X-Forwarded-For. The last entry identifies the source.
# Otherwise all requests share one source bucket. Global failure counting applies either way.
TRUST_PROXY=false

# ACCESS_PASSWORD and SESSION_SECRET are required in production and for private development.
# Generate each credential independently using a cryptographically secure random generator.
# Viewer login password. Generate at least 24 random characters with a password manager.
ACCESS_PASSWORD=
# HMAC session signing key (at least 32 characters). Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional server-only manual sync token (at least 32 characters). Generate with: openssl rand -hex 32
# Supply as x-admin-token from the operator environment. Leave empty to disable manual HTTP sync.
ADMIN_TOKEN=

# Readiness freshness (Package F, provisional initial values)
MAX_SNAPSHOT_AGE_MINUTES=1440
# Coverage gate overrides (Package E). Defaults come from
# config/coverage-thresholds.json (provisional 80% basis: 124 scored /
# 93 positive-estimate homepage models). Set only to override.
# MIN_SCORED_MODELS=
# MIN_POSITIVE_ESTIMATE_MODELS=
# Runtime data root for publication files (defaults to ./data). In the
# container deployment this is /app/data on the shared volume.
# MODEL_COMPASS_DATA_DIR=/app/data
# Git publication from CI is gated by the AA_GIT_PUBLICATION_APPROVED
# repository variable (default off) — it is a CI setting, not an app env.
