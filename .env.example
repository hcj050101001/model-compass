# Artificial Analysis Data API
AA_API_KEY=
AA_API_TIER=free
AA_API_BASE_URL=https://artificialanalysis.ai/api/v2

# OpenRouter optional enrichment
OPENROUTER_ENABLED=true
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Sync & Database
DATA_SYNC_INTERVAL_MINUTES=60
MANUAL_SYNC_COOLDOWN_SECONDS=120
DATABASE_URL=file:./data/frontier.db

# Application
APP_NAME=LLM Frontier
APP_TIMEZONE=Asia/Shanghai
DEMO_MODE=true
PRIVATE_MODE=true

# Security (required when PRIVATE_MODE=true or using admin sync)
ACCESS_PASSWORD=
ADMIN_TOKEN=
SESSION_SECRET=
